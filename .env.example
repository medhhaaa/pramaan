# Copy this file to .env and fill in your own values. Never commit .env.

# Which AI to use: anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Leave empty to use the default for the provider (anthropic: claude-opus-5-5)
LLM_MODEL=

# Local mode (optional, P3)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Fernet key for encrypted file storage. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=
