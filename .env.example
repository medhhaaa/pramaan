# Copy this file to .env and fill in your own values. Never commit .env.

# --- AI ---
# The team uses Groq (OpenAI-compatible). Get the key from the setup lead by direct message.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# The OpenAI library reads this address automatically, so calls go to Groq
OPENAI_BASE_URL=https://api.groq.com/openai/v1
#
# Other options:
#   Claude: LLM_PROVIDER=anthropic, LLM_MODEL empty (default claude-opus-5-5), remove OPENAI_BASE_URL
#   OpenAI: LLM_PROVIDER=openai, remove OPENAI_BASE_URL
#   Local:  LLM_PROVIDER=ollama
#
# Check it works:  python -m pipeline.llm   -> prints {"ok": true}

# Local mode (optional, P3)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Fernet key for encrypted file storage. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# Address phones use to open the app (QR share links point here). For phone testing set it
# to http://<this laptop Wi-Fi IP>:5173 and run: npm run dev -- --host
FRONTEND_URL=http://localhost:5173

# Read handwritten pages with a cloud vision model (pipeline/handwriting.py). The page is sent only
# after the patient's name, IDs, phone and address are blacked out. Leave empty = local model only.
# e.g. qwen-vl on free.ai
VISION_MODEL=

# Optional vision providers for handwritten pages (VISION_PROVIDER=github or gemini; empty = VISION_MODEL above)
# VISION_PROVIDER=
# GITHUB_TOKEN=          GitHub personal access token with the "models" permission
# GEMINI_API_KEY=        from aistudio.google.com
# GITHUB_VISION_MODEL=openai/gpt-4o
# GEMINI_VISION_MODEL=gemini-3-flash-preview

# In-page search (Medications / Records pages). Optional: pip install -r requirements-search.txt
# SEARCH_EMBEDDINGS=off turns the "Similar meaning" tier off. SEARCH_SIMILAR_MIN is the cosine a
# match needs (0.55: with this small model it rarely fires, but never wrongly).
SEARCH_EMBEDDINGS=on
SEARCH_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEARCH_SIMILAR_MIN=0.55

# The agent retries facts it could not prove with this stronger model (pipeline/self_check.py).
# Empty = skip that retry. e.g. deepseek-r1 on free.ai
LLM_STRONG_MODEL=
