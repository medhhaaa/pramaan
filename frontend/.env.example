# Copy to .env.local. Leave USE_DUMMY on until the backend is running.
VITE_USE_DUMMY=true
VITE_API_URL=http://localhost:8000
VITE_SHOW_DEMO_HINT=true
VITE_ENABLE_CLAIM_READY=false
VITE_ENABLE_ASK=false
# Audit log screen (every action is still recorded either way)
VITE_ENABLE_AUDIT=false
# Doctor and patient assistants (AGENTIC_PLAN point 15). They call the AI: keep false unless LLM_* is set up.
VITE_ENABLE_ASSISTANT=false
